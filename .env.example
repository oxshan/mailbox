# 首次启动时导入的收信域名，逗号分隔；之后在看板的“域名管理”里维护
MAIL_DOMAINS=

# 接口密钥；留空则首次启动自动生成并保存在数据卷里
API_KEY=

# 邮件保留时长（小时）；0 表示不自动清理，永久保留
RETENTION_HOURS=24

# 发信用的 Resend API Key；留空则不启用发信功能
RESEND_API_KEY=

# 每小时最多转发的邮件数（转发邮箱在看板的“邮件转发”里维护）；0 表示不限制
FORWARD_HOURLY_LIMIT=60

# 本服务器的公网 IP，用于 MX 检测；留空则自动探测
PUBLIC_IP=

# 宿主机端口。收外部邮件必须用 25；本机试用可改成 2525
SMTP_PORT=25
HTTP_PORT=8080
